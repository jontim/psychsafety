# Copy to .env and fill in. Keys never reach the browser; the server mints short-lived tokens.
HUME_API_KEY=
HUME_SECRET_KEY=
# Optional: an EVI config id from the Hume platform. Blank uses Hume's default config.
HUME_CONFIG_ID=
# Optional: an Octave voice name from your Hume voice library to use when a character has none.
HUME_DEFAULT_VOICE=
ANTHROPIC_API_KEY=
DIRECTOR_MODEL=claude-opus-5
# low | medium | high | xhigh | max. Medium keeps a turn under a few seconds.
DIRECTOR_EFFORT=medium
PORT=8787
