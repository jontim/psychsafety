{
  "name": "shadow-fell",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "The Shadow Fell: a voice-first story engine for the unshown middle of Death Came to Dinner. The world listens to how you say it.",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "concurrently -k -n web,server -c cyan,yellow \"vite\" \"tsx watch src/server/index.ts\"",
    "dev:web": "vite",
    "dev:server": "tsx watch src/server/index.ts",
    "build": "tsc -p tsconfig.json --noEmit && vite build",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "start": "NODE_ENV=production tsx src/server/index.ts",
    "preview": "vite preview",
    "compile:canon": "tsx scripts/compile-canon.ts",
    "eval:attribution": "tsx scripts/eval-attribution.ts"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.126.0",
    "@fal-ai/client": "^1.10.1",
    "dotenv": "^16.4.5",
    "express": "^4.21.2",
    "hume": "^0.16.1",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@types/express": "^4.17.21",
    "@types/node": "^22.10.2",
    "concurrently": "^9.1.0",
    "playwright-core": "^1.52.0",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2",
    "vite": "^8.3.0",
    "vitest": "^5.0.1"
  }
}
